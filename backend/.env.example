# SQLite database location. Relative paths are resolved from the backend directory.
DATABASE_URL=sqlite:///./signal_clone.db

# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to false in production to avoid exposing internal error details in logs.
DEBUG=true

# Development-only authentication settings. Do not use these values in production.
AUTH_SECRET_KEY=change-this-before-production
DEV_OTP=123456
ACCESS_TOKEN_EXPIRE_MINUTES=1440
